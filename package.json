{
  "name": "dsh-soniox",
  "version": "0.1.1",
  "description": "Native BYOK Soniox speech-to-text provider for DeepSeek Harness (SONIOX_API_KEY).",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "soniox.mjs",
    "languages.mjs",
    "cordis.patch.yml",
    "locale/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "soniox",
    "speech-to-text",
    "stt",
    "voice-input",
    "byok"
  ],
  "homepage": "https://github.com/XimilalaXiang/dsh-soniox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XimilalaXiang/dsh-soniox.git"
  },
  "bugs": {
    "url": "https://github.com/XimilalaXiang/dsh-soniox/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "for f in *.mjs; do node --check \"$f\" || exit 1; done",
    "live": "node scripts/live-check.mjs",
    "integration": "node scripts/dsh-integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-experimental-api-speech-to-text": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-experimental-client-ui-voice-input": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-experimental-speech-to-text": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-experimental-api-speech-to-text": { "optional": true },
    "@deepseek-ai/dsh-experimental-client-ui-voice-input": { "optional": true },
    "@deepseek-ai/dsh-experimental-speech-to-text": { "optional": true }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
